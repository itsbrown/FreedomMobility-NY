# Formspree endpoint (create a form at formspree.io and paste the endpoint here)
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id-here

# Optional dedicated Formspree form for /tech/pay. Create a form whose Email
# workflow notifies brian.parmele@freedommobilityva.com. If unset, pay uses
# PUBLIC_FORMSPREE_ENDPOINT (the public contact form) — that does NOT CC Brian.
# PUBLIC_PAY_FORMSPREE_ENDPOINT=https://formspree.io/f/pay-form-id-here

# Shared PIN for /admin, /admin/rates, and /tech/pay
# Leave blank to skip the gate in local dev only
PUBLIC_TECH_PAY_PIN=change-me

# Optional server-only copy used by /api/pay-rates (falls back to PUBLIC_TECH_PAY_PIN)
# TECH_PAY_PIN=change-me

# Google reCAPTCHA v3 site key (get from https://www.google.com/recaptcha/admin/create)
# Only needed if using CAPTCHA (enabled in Formspree dashboard)
# IMPORTANT: Use a real key registered for freedommobilityny.com (not the test key)
PUBLIC_RECAPTCHA_SITE_KEY=your-real-site-key-here
