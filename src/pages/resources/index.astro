---
import Layout from '../../layouts/Layout.astro';
import { getLivePosts, publicPath, formatDate, displayDate } from '../../lib/blog';

const posts = await getLivePosts();
const title = 'Resources & Guides | Freedom Mobility NY';
const description = 'Local guides on stairlifts, ramps, costs, and winter accessibility for homes in Rochester, Buffalo, and Syracuse NY.';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Freedom Mobility NY Guides',
  description,
  url: 'https://freedommobilityny.com/resources/',
  isPartOf: { '@id': 'https://freedommobilityny.com/#website' },
  about: ['Stairlifts', 'Ramps', 'Home accessibility', 'Rochester NY', 'Buffalo NY', 'Syracuse NY'],
};
---

<Layout
  title={title}
  description={description}
  extraJsonLd={[collectionSchema]}
  breadcrumbs={[
    { name: 'Home', href: 'https://freedommobilityny.com/' },
    { name: 'Guides', href: 'https://freedommobilityny.com/resources/' },
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <p class="text-xs uppercase tracking-wider text-sky-700 font-semibold mb-2">Rochester · Buffalo · Syracuse</p>
    <h1 class="text-4xl font-bold tracking-tight mb-3">Helpful resources</h1>
    <p class="text-lg text-slate-600 max-w-2xl mb-10">
      Straight answers on cost, equipment, and New York winters — written for families shopping a stairlift, ramp, or lift in our service area.
    </p>

    <div class="grid gap-5 md:grid-cols-2">
      {posts.map((post) => (
        <a href={publicPath(post)} class="block p-6 border border-slate-200 rounded-2xl hover:border-sky-300 hover:shadow-sm transition bg-white">
          <div class="text-xs uppercase tracking-wider text-slate-500 mb-2">{post.data.category}</div>
          <h2 class="font-semibold text-lg text-slate-900">{post.data.headline}</h2>
          <p class="text-sm text-slate-600 mt-2">{post.data.description}</p>
          <p class="text-xs text-slate-400 mt-4">Updated {formatDate(displayDate(post))}</p>
        </a>
      ))}
    </div>

    <p class="mt-10 text-sm text-slate-500">
      Have a question? <a href="/contact" class="underline">Contact us</a> for a free in-home visit.
      See the <a href="/brands" class="underline">brands</a> we install, or read <a href="/testimonials" class="underline">client stories</a>.
    </p>
  </div>
</Layout>
