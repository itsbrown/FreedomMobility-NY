---
import Layout from '../layouts/Layout.astro';
import { RATES_DRAFT, PAY_FORM_RECIPIENT } from '../data/pay-rates';
---

<Layout
  title="Admin | Freedom Mobility NY"
  description="Internal Freedom Mobility NY shop tools."
  variant="internal"
  noindex={true}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
    <p class="text-xs uppercase tracking-wider text-sky-700 font-semibold mb-2">Internal</p>
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">Shop admin</h1>
    <p class="text-slate-600 mb-8 max-w-2xl">
      Tools for technicians and office staff. These pages are unlisted and not in the public menu.
    </p>

    <div class="grid sm:grid-cols-2 gap-4">
      <a href="/tech/pay" class="group block rounded-2xl border border-slate-200 bg-white p-5 hover:border-sky-300 hover:shadow-sm transition">
        <div class="text-xs uppercase tracking-wider text-slate-500 mb-2">Timesheets</div>
        <h2 class="text-lg font-semibold text-slate-900 group-hover:text-sky-700">Weekly pay form</h2>
        <p class="text-sm text-slate-600 mt-2">
          Log installs, service calls, and mileage. Submissions email {PAY_FORM_RECIPIENT}.
        </p>
        <div class="mt-4 text-sm font-medium text-sky-700">Open form →</div>
      </a>

      <a href="/admin/rates" class="group block rounded-2xl border border-slate-200 bg-white p-5 hover:border-sky-300 hover:shadow-sm transition">
        <div class="text-xs uppercase tracking-wider text-slate-500 mb-2">Setup</div>
        <h2 class="text-lg font-semibold text-slate-900 group-hover:text-sky-700">Pay rates</h2>
        <p class="text-sm text-slate-600 mt-2">
          Edit piece rates, mileage, technician names, and the timesheet inbox. The pay form uses whatever you save here.
        </p>
        <div class="mt-4 text-sm font-medium text-sky-700">Edit rates →</div>
      </a>
    </div>

    {RATES_DRAFT && (
      <p class="mt-8 text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3">
        Pay rates are still marked draft.
        <a href="/admin/rates" class="underline font-medium">Open Pay rates</a>
        to confirm numbers before the first payday.
      </p>
    )}
  </div>
</Layout>
