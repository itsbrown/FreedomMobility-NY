---
import Layout from '../../../layouts/Layout.astro';
import BlogArticle from '../../../components/BlogArticle.astro';
import { getAllPosts, getLivePosts, relatedPosts, postSlug } from '../../../lib/blog';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const live = posts.filter((post) => post.data.draft !== true);
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post, related: relatedPosts(post, live) },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`Preview: ${post.data.headline} | Admin`}
  description="Internal blog preview."
  variant="internal"
  noindex={true}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <p class="text-xs uppercase tracking-wider text-sky-700 font-semibold">
      <a href="/admin" class="hover:text-sky-800">Admin</a>
      <span class="text-slate-300 mx-1.5">/</span>
      <a href="/admin/blog" class="hover:text-sky-800">Blog</a>
      <span class="text-slate-300 mx-1.5">/</span>
      Preview
    </p>
  </div>
  <BlogArticle post={post} related={related} preview={true}>
    <Content />
  </BlogArticle>
</Layout>
